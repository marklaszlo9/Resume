source 'https://rubygems.org'

# GitHub Pages — pulls in a compatible Jekyll and the standard plugin set.
# Pinning to latest keeps the repo buildable both locally and on GH Pages.
gem 'github-pages', group: :jekyll_plugins

group :jekyll_plugins do
  gem 'jekyll-sitemap'
  gem 'jekyll-seo-tag'
end

# Required on Ruby 3.x — webrick is no longer bundled.
gem 'webrick', '~> 1.9'
